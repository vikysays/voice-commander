            "max_record_seconds": 14.0,
            "cooldown_seconds": 1.0,
        },
        "apps": {
            "terminal": "omarchy-launch-terminal",
            "console": "omarchy-launch-terminal",
            "shell": "omarchy-launch-terminal",
            "tmux": "omarchy-launch-terminal-tmux",
            "herdr": "omarchy-launch-terminal-herdr",
            "browser": "omarchy-launch-browser",
            "chrome": "omarchy-launch-browser",
