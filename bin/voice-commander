#!/usr/bin/env python3
"""
Voice Commander v2 for Omarchy Linux + Superwhisper + Samson GoMic.

Upgrades in v2:
1. Adaptive Noise-Floor VAD + Hysteresis:
   - Dynamically tracks ambient room noise on the Samson GoMic so background hum (RMS 700-1100)
     never holds the recording open for 25 seconds.
   - Stops recording within 0.85s after you finish speaking.
2. Live Runtime Recording OSD + Superwhisper Realtime Preview:
   - Shows a live updating desktop OSD indicator ("Listening... 1.2s [||||..]") while speaking.
3. Multi-Command & Conversational Command Extraction:
   - Splits compound utterances ("Exit. Computer workspace two. Computer open terminal.") and
     extracts embedded wake-word commands ("Open. Can you please open the browser? Computer, open the browser.")
     so they NEVER get typed into active input fields like Herdr/Antigravity.
   - Strips polite conversational wrappers ("can you please", "could you", "please", "actually").
   - Supports trailing inline actions like "... over", "... enter", "... press enter".
4. Personal Browser & Desktop Agent ("Computer, find link ...", "Computer, open first result",
   "Computer, click on ...", "Computer, search on page for ...", "Computer, ask assistant ..."):
   - Directly controls browser navigation, link clicking via Quick Find (`'` / Ctrl+F + Enter),
     URL bar typing, form filling, tab switching, and launching/prompting AI assistant tasks.
"""

from __future__ import annotations

import argparse
import collections
import json
import math
import os
import re
import shutil
import signal
import struct
import subprocess
import sys
import threading
import time
import tomllib
from pathlib import Path
from typing import Any
from urllib.parse import quote_plus

CONFIG_PATH = Path.home() / ".config" / "voice-commander" / "config.toml"
STATE_PATH = Path.home() / ".local" / "state" / "voice-commander" / "state.json"
RECORDINGS_DIR = Path.home() / ".local" / "share" / "superwhisper" / "recordings"

DRY_RUN = False

NUMBER_WORDS: dict[str, int] = {
    "one": 1, "won": 1, "first": 1, "1": 1, "1st": 1,
    "two": 2, "to": 2, "too": 2, "second": 2, "2": 2, "2nd": 2,
    "three": 3, "third": 3, "3": 3, "3rd": 3,
    "four": 4, "for": 4, "fourth": 4, "4": 4, "4th": 4,
    "five": 5, "fifth": 5, "5": 5, "5th": 5,
    "six": 6, "sixth": 6, "6": 6, "6th": 6,
    "seven": 7, "seventh": 7, "7": 7, "7th": 7,
    "eight": 8, "eighth": 8, "8": 8, "8th": 8,
    "nine": 9, "ninth": 9, "9": 9, "9th": 9,
    "ten": 10, "tenth": 10, "10": 10, "10th": 10,
}

TERMINAL_CLASSES = {
    "alacritty", "foot", "kitty", "com.mitchellh.ghostty", "ghostty",
    "wezterm", "org.wezfurlong.wezterm", "xterm", "konsole", "gnome-terminal",
    "org.omarchy.agent", "herdr",
}

# Single-word noise fragments that are ignored when part of a multi-segment command retry
NOISE_FRAGMENTS = {"open", "exit", "the", "a", "an", "uh", "um", "oh", "ah", "okay", "ok", "hey"}
WHISPER_HALLUCINATIONS = {
    "thank you",
    "thank you very much",
    "thanks",
    "thanks for watching",
    "thank you for watching",
    "you're welcome",
    "you are welcome",
    "bye",
    "bye bye",
    "goodbye",
    "subtitles by",
    "amara.org",
    "...",
}

BROWSER_CLASSES = {
    "chromium", "google-chrome", "chrome", "firefox", "brave", "brave-browser", "zen", "vivaldi",
}

POLITE_PREFIX_RE = re.compile(
    r"^(?:can\s+you\s+please|could\s+you\s+please|would\s+you\s+please|can\s+you|could\s+you|would\s+you|please|just|now|i\s+want\s+you\s+to|i\s+want\s+to)\s+",
    flags=re.IGNORECASE,
)

POLITE_SUFFIX_RE = re.compile(
    r"\s+(?:please|for\s+me|right\s+now|now|actually|thank\s+you|thanks)$",
    flags=re.IGNORECASE,
)


